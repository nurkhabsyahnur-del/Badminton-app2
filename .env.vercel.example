# Salin nilai di bawah ke Vercel Dashboard > Project > Settings > Environment Variables
# Jangan commit file .env asli ke GitHub.

APP_NAME="GOR Metro Badminton"
APP_ENV=production
APP_KEY=base64:zEVW+oggDlxyM8/PursFx3saTP134xjklQthL9Zdg6U=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Dibiarkan kosong: api/index.php mengisi otomatis dari host Vercel.
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- DATABASE ---
# Default aman di Vercel: SQLite sementara di /tmp/database.sqlite.
# File dibuat + di-migrate + di-seed otomatis, tetapi tidak persisten
# antar cold start (cukup untuk demo/UTS).
#
# PENTING: jangan isi DB_HOST / DB_URL dengan "..." atau placeholder lain.
# Nilai seperti itu akan dibuang oleh aplikasi dan akan dipakai fallback
# SQLite, sehingga tidak ada error:
#   could not translate host name "..." to address
DB_CONNECTION=sqlite
DB_URL=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- JIKA PAKAI DATABASE EKSTERNAL ---
# Opsi A (paling mudah): isi DB_URL dengan host asli, lalu DB_CONNECTION:
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@db.xyz.neon.tech/db_name?sslmode=require
#
# Atau MySQL:
# DB_CONNECTION=mysql
# DB_URL=mysql://USER:PASSWORD@db.xyz.host:3306/db_name
#
# Opsi B: tanpa URL, isi DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
# dengan nilai asli (bukan "..."). DB_HOST tidak boleh localhost/127.0.0.1.
# Contoh:
# DB_CONNECTION=pgsql
# DB_HOST=db.xyz.neon.tech
# DB_PORT=5432
# DB_DATABASE=db_name
# DB_USERNAME=USER
# DB_PASSWORD=PASSWORD
# DB_SSLMODE=require

# --- SERVERLESS-SAFE DEFAULTS ---
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
UPLOAD_DRIVER=database

VIEW_COMPILED_PATH=/tmp/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
