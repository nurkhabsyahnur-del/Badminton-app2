# Salin nilai di bawah ke Vercel Dashboard > Project > Settings > Environment Variables
# Jangan commit file .env asli ke GitHub.

APP_NAME="GOR Metro Badminton"
APP_ENV=production
APP_KEY=base64:zEVW+oggDlxyM8/PursFx3saTP134xjklQthL9Zdg6U=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Dibiarkan kosong: api/index.php mengisi otomatis dari host Vercel.
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- DATABASE ---
# Disarankan: Postgres/MySQL eksternal gratis (Neon, Supabase, dll).
# Contoh Neon:
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@HOST/db_name?sslmode=require
#
# Contoh MySQL:
# DB_CONNECTION=mysql
# DB_URL=mysql://USER:PASSWORD@HOST:3306/db_name
#
# Jika DB_URL kosong, aplikasi memakai SQLite sementara di /tmp/database.sqlite
# dan akan di-migrate + di-seed otomatis (data tidak persisten antar cold start).
DB_CONNECTION=pgsql
DB_URL=

# --- SERVERLESS-SAFE DEFAULTS ---
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
UPLOAD_DRIVER=database

VIEW_COMPILED_PATH=/tmp/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
